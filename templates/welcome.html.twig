{% extends 'base-logout.html.twig' %}

{% block title %}Bienvenue{% endblock %}

{% block body %}
    <div class="container-logo">
        <img src="{{ asset('img/logo.png') }}" alt="logo">
    </div>
    <div class="container-form">
        <div class="row">
            <h1 class="welcome-title">Bienvenue sur TaskLinker</h1>
            <h2>Commencez dès maintenant - gratuitement</h2>
        </div>

        <h3 class="link-login-welcome"  >Vous avez déja un compte ?</h3>

        <a type="submit" class="button-login" href="{{ path('app_login') }}">Se connecter</a>

        <div class="separator">
            <div class="separator-line"></div>
            <span>ou</span>
            <div class="separator-line"></div>
        </div>

        <a type="submit" class="button-registration" href="{{ path('app_register') }}" >S'inscrire</a>

    </div>


{% endblock %}
