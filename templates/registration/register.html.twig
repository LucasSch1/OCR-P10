{% extends 'base-logout.html.twig' %}

{% block title %}S'inscrire{% endblock %}

{% block body %}
    <div class="container-logo">
        <img src="{{ asset('img/logo.png') }}" alt="logo">
    </div>
    <div class="container-form">
        <h1 class="register-title">S'inscrire</h1>
        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.nom,{label:'Nom'}) }}
        {{ form_row(registrationForm.prenom,{label:'Prénom'}) }}
        {{ form_row(registrationForm.email,{label:'E-mail'}) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}

        <button type="submit" class="button-submit-registration">Continuer</button>

        <a class="link-login" href="{{ path('app_login') }}">Vous avez déja un compte ?</a>
        {{ form_end(registrationForm) }}
    </div>


{% endblock %}
